{
    "name":  "dsh-prompt-optimizer-button",
    "version":  "0.4.4",
    "type":  "module",
    "description":  "Prompt optimizer button between the model selector and send: rewrites the draft in place with one model call, with scenario detection and a compact diagnosis panel (POST /prompt-optimizer/rewrite).",
    "license":  "MIT",
    "author":  "Prompt Optimizer Button contributors",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/AZ-666316/dsh-prompt-optimizer-button.git"
                   },
    "homepage":  "https://github.com/AZ-666316/dsh-prompt-optimizer-button",
    "bugs":  {
                 "url":  "https://github.com/AZ-666316/dsh-prompt-optimizer-button/issues"
             },
    "engines":  {
                    "dsh":  "\u003e=0.2.2-rc.1 \u003c0.3.0-0"
                },
    "keywords":  [
                     "dsh-plugin",
                     "dsh",
                     "prompt",
                     "prompt-optimizer",
                     "composer",
                     "scenario"
                 ],
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE",
                  "assets",
                  "screenshots.json",
                  "skills"
              ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-conversation"
                                          ]
                           }
            }
}